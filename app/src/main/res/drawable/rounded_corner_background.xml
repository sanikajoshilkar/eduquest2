<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Set the background color for the rounded corner -->
    <solid android:color="#8FD1ED" />

    <!-- Define the radius for rounded corners -->
    <corners android:radius="12dp" />

    <!-- Optional: Add padding if needed -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

    <!-- Optional: Add a border/stroke -->
    <stroke
        android:width="2dp"
        android:color="#004FEF" />
</shape>
