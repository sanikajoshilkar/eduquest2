<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_app_bar_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:elevation="4dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        app:buttonGravity="center_vertical"
        app:contentInsetStartWithNavigation="0dp"
        app:titleTextColor="@color/black">

        <!-- Toggle Button for Profile/Skills Filter -->
        <ToggleButton
            android:id="@+id/toggleFilter"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textOff="Skills"
            android:textOn="Profile"
            android:fontFamily="@font/monsterrat_regular"
            android:checked="true"
        android:textColor="@color/black"
        android:backgroundTint="@color/blue_accent_300"
        android:padding="8dp" />

        <!-- Search TextInputLayout and EditText for Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchOutlinedTextLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:focusable="false"
            app:boxStrokeColor="@color/blue_accent_300"
            app:endIconMode="clear_text"
            app:endIconTint="@color/blue_accent_300"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search_24"
            app:startIconTint="@color/blue_accent_300">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/home_search_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search Profile"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/gray"
                android:textColorHint="@color/gray" />

        </com.google.android.material.textfield.TextInputLayout>

    </com.google.android.material.appbar.MaterialToolbar>

</com.google.android.material.appbar.AppBarLayout>
